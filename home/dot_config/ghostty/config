font-family = "Atkinson Hyperlegible Mono"
font-family = "Symbols Nerd Font Mono"
font-size = 16

term = xterm-256color
shell-integration-features = no-cursor

theme = Abernathy
bold-is-bright = true
minimum-contrast = 3
selection-foreground = white
selection-background = dark blue
cursor-opacity = 0.8
cursor-style = block

macos-titlebar-style = native
macos-option-as-alt = true
quit-after-last-window-closed = false
window-padding-x = 8
window-padding-y = 8

# Hyper+`
keybind = global:super+ctrl+alt+shift+`=toggle_quick_terminal
quick-terminal-position = right

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+]=goto_split:next
keybind = cmd+[=goto_split:previous

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+[=previous_tab
keybind = cmd+shift+]=next_tab
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4
keybind = cmd+5=goto_tab:5
keybind = cmd+6=goto_tab:6
keybind = cmd+7=goto_tab:7
keybind = cmd+8=goto_tab:8
keybind = cmd+9=goto_tab:9

# Windows
keybind = cmd+shift+n=new_window
keybind = cmd+w=close_surface

# Font size
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Clear scrollback
keybind = cmd+k=clear_screen

# Fullscreen
keybind = cmd+shift+enter=toggle_fullscreen
