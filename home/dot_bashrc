#!/usr/bin/env bash

# Don't load more files unless interactive mode.
case $- in
  *i*) ;;
  *) return ;;
esac

# Each file owns one piece of interactive Bash setup. An empty glob is skipped.
for _bash_module in "${XDG_CONFIG_HOME:-$HOME/.config}"/bash/conf.d/*.bash; do
  [ -f "$_bash_module" ] && [ -r "$_bash_module" ] || continue
  . "$_bash_module"
done
unset _bash_module
